# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git에 올라가지 않습니다.

# --- 기업 규모·보수 정보 (공공데이터포털) ---------------------------------
# https://www.data.go.kr → "국민연금공단_국민연금 가입 사업장 내역" 활용신청
# 발급 후 "일반 인증키(Decoding)" 값을 넣으세요.
NPS_SERVICE_KEY=

# --- 워크넷 채용공고 (고용24 오픈API) --------------------------------------
# https://openapi.work.go.kr → 오픈API 신청 → 채용정보
WORKNET_AUTH_KEY=

# --- 마감 알림: 텔레그램 ----------------------------------------------------
# @BotFather 에게 /newbot 으로 봇을 만들고 받은 토큰,
# 봇에게 아무 메시지나 보낸 뒤 https://api.telegram.org/bot<토큰>/getUpdates 에서 chat id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 마감 알림: 이메일 ------------------------------------------------------
# Gmail은 2단계 인증 후 "앱 비밀번호"를 발급받아 SMTP_PASSWORD에 넣으세요.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
