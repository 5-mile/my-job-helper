# ============================================================================
#  my-job-helper 설정 파일
# ============================================================================
#
#  [사용법]
#    1. 이 파일을 `.env` 로 복사하세요:   cp .env.example .env
#    2. 필요한 값만 채우면 됩니다. 전부 비워도 앱은 정상 동작합니다.
#    3. 값을 바꾼 뒤에는 앱을 다시 시작해야 반영됩니다.
#
#  [중요]
#    - `.env` 는 .gitignore 에 있어 git에 올라가지 않습니다. 비밀 값은 여기에만
#      두세요. 실수로 코드나 커밋에 넣지 마세요.
#    - Streamlit Cloud에 배포한 경우 `.env` 는 서버에 없습니다.
#      같은 내용을 Manage app → Settings → Secrets 에 TOML 형식으로 넣으세요:
#          DATABASE_URL = "postgresql://..."
#      넣은 뒤 반드시 Reboot app 하세요.
#    - 값에 따옴표를 붙이지 마세요. `KEY=값` 형태 그대로 씁니다.
#      (Streamlit Secrets 쪽은 반대로 따옴표가 필요합니다.)
#
#  [키 없이도 되는 것]
#    사람인 웹 수집, 네이버 블로그 피드, 보관함·지원 트래커, CSV 내보내기,
#    D-Day 계산, 시장 트렌드 분석 — 전부 설정 없이 동작합니다.
#
# ============================================================================


# ============================================================================
#  1. DATABASE_URL — 보관함 영구 저장            [무료]  [클라우드 배포 시 필수]
# ============================================================================
#
#  무엇을 하나요
#    스크랩한 공고, 지원 진행 상태, 메모, 자소서, 공고 이력을 외부 DB에 저장합니다.
#
#  언제 필요한가요
#    - 로컬에서만 쓴다면 필요 없습니다. 비워두면 프로젝트 폴더의 jobs.db(SQLite)를
#      씁니다.
#    - Streamlit Cloud에 배포했다면 필수입니다. 클라우드는 파일시스템이 휘발성이라
#      앱이 재시작하거나 절전에서 깨어날 때마다 보관함이 통째로 사라집니다.
#
#  발급 방법 (Supabase 무료 플랜)
#    1) https://supabase.com/dashboard 에서 프로젝트 생성
#       - 이때 정한 Database Password를 기억해 두세요.
#    2) 프로젝트 화면 상단 가운데 초록색 [Connect] 버튼
#    3) 'Direct Connection string' 탭 선택
#    4) Connection Method에서 반드시 → Session pooler ← 선택
#       * 기본값인 Direct connection은 IPv6 전용입니다. Streamlit Cloud는 IPv4라
#         'Name or service not known' 으로 실패합니다. 반드시 pooler를 쓰세요.
#       * 올바른 주소는 aws-0-<지역>.pooler.supabase.com:5432 형태입니다.
#       * 사용자명이 postgres 가 아니라 postgres.<프로젝트ID> 인지 확인하세요.
#    5) Type을 URI로 두고 문자열 복사
#    6) [YOUR-PASSWORD] 부분을 실제 비밀번호로 교체
#       ★ 대괄호 [ ] 까지 함께 지워야 합니다. 안쪽 글자만 바꾸면 대괄호가
#         비밀번호의 일부가 되어 인증에 실패합니다. 가장 흔한 실수입니다.
#
#  비밀번호에 특수문자가 있다면 (URI 규칙)
#    !  #  ?  :  $  *   → 그대로 두면 됩니다
#    @ → %40      / → %2F      % → %25      [ → %5B      ] → %5D
#
#  설정 후 확인
#    python setup_cloud.py     연결 확인 + 기존 데이터 이전 + Secrets 파일 생성
#    python check_db.py        연결만 점검
#    python migrate_db.py      로컬 SQLite → 외부 DB 이전 (--dry-run 먼저 권장)
#
DATABASE_URL=


# ============================================================================
#  2. WORKNET_AUTH_KEY — 워크넷 채용공고                            [무료]
# ============================================================================
#
#  무엇을 하나요
#    사람인에 이어 두 번째 채용 소스를 켭니다. 사이드바 '공고 소스'에서 선택할 수
#    있게 됩니다.
#
#  왜 좋은가요
#    - 공식 API라 사이트 개편에 영향을 받지 않습니다 (웹 수집은 구조가 바뀌면
#      멈춥니다).
#    - 사람인에 없는 공공기관·중소기업 공고가 많이 잡힙니다.
#    - 급여 정보가 함께 옵니다. 사람인 웹 수집으로는 못 가져오는 값입니다.
#
#  발급 방법
#    1) https://openapi.work.go.kr 접속
#    2) 회원가입 후 오픈API 신청 → '채용정보' 선택
#    3) 승인되면 발급되는 인증키를 아래에 붙여넣기
#
#  ※ 키 없이 공고를 늘리려면: 사이드바에서 검색어를 쉼표로 여러 개 넣고,
#    페이지 수를 올리고, "정렬 3종 합쳐서 더 많이 수집"을 켜세요.
#    실측으로 120건 → 1,000건까지 늘어납니다.
#
WORKNET_AUTH_KEY=


# ============================================================================
#  3. PUBLIC_JOBS_KEY — 공공기관 채용정보 (잡알리오)                  [무료]
# ============================================================================
#
#  무엇을 하나요
#    공기업·공공기관 채용공고만 따로 수집합니다. 결과는 '공공기관' 탭에 모입니다.
#
#  왜 좋은가요
#    사람인·워크넷과 거의 겹치지 않습니다. 공기업을 노린다면 순수하게 늘어나는
#    공고입니다.
#
#  발급 방법
#    1) https://www.data.go.kr 회원가입
#    2) "공공기관 채용정보" 검색 → 활용신청 (보통 즉시 승인)
#    3) 마이페이지 → 인증키에서 → 일반 인증키(Decoding) ← 값을 복사
#       ★ Encoding 키가 아니라 Decoding 키입니다. 헷갈리기 쉽습니다.
#
PUBLIC_JOBS_KEY=


# ============================================================================
#  4. NPS_SERVICE_KEY — 국민연금 기업정보                            [무료]
# ============================================================================
#
#  무엇을 하나요
#    공고 카드에 그 회사의 실제 규모를 붙입니다.
#      👥 1,234명        국민연금 가입자 수 (≈ 직원 수)
#      💰 월평균 380만    고지금액에서 역산한 추정 보수
#      🔄 입10/퇴5       당월 입·퇴사 인원
#    사이드바에서 '최소 직원 수'로 필터링할 수도 있습니다.
#
#  왜 좋은가요
#    - 회사 규모를 숫자로 확인할 수 있습니다.
#    - 직원 수가 극단적으로 적은데 공고를 많이 올리는 회사는 채용대행·파견일
#      가능성이 높습니다. 걸러내는 데 유용합니다.
#
#  이 숫자의 한계 (알고 쓰세요)
#    - 사업장(공장·지점)별로 분리 신고되어 전사 인원과 다를 수 있습니다.
#    - 월평균 보수는 고지금액 ÷ 인원 ÷ 0.09 로 역산한 추정치입니다.
#    - 국민연금 기준소득월액 상한(월 637만원) 때문에 고연봉 회사는 실제보다
#      낮게 나옵니다. 상한에 걸린 경우 `380만+` 처럼 `+`를 붙여 표시합니다.
#
#  발급 방법
#    1) https://www.data.go.kr 에서 "국민연금공단_국민연금 가입 사업장 내역" 검색
#    2) 활용신청 → 마이페이지 → 일반 인증키(Decoding) 복사
#
NPS_SERVICE_KEY=


# ============================================================================
#  5. SARAMIN_API_KEY — 사람인 공식 오픈API                          [무료]
# ============================================================================
#
#  무엇을 하나요
#    지금의 사람인 웹 수집을 공식 API로 대체(또는 병행)합니다.
#
#  왜 좋은가요
#    웹 수집은 사람인이 페이지 구조를 바꾸면 멈춥니다. 공식 API는 그 위험이
#    없습니다. 지역·경력·학력 필터도 서버에서 걸 수 있습니다.
#    당장 급하지는 않지만 보험 성격으로 유용합니다.
#
#  발급 방법
#    https://oapi.saramin.co.kr 에서 신청 후 access-key 발급
#
SARAMIN_API_KEY=


# ============================================================================
#  6. ANTHROPIC_API_KEY — 자소서 초안 · 적합도 분석            [유료: 종량제]
# ============================================================================
#
#  무엇을 하나요
#    보관함의 각 공고에 두 개의 탭이 켜집니다.
#      🎯 적합도 분석 — 내 프로필과 공고를 비교해 점수·맞는 지점·부족한 조건
#      ✍️ 자소서      — 문항별 초안 작성, 수정 후 저장·재사용
#
#  ★ 먼저 화면 아래 '내 프로필'을 채워야 합니다
#    경력, 자격증, 그리고 무엇보다 경험 에피소드(상황-행동-결과)를 적어두세요.
#    그것이 자소서의 재료가 됩니다. 프로필이 비어 있으면 기능이 잠깁니다.
#
#  지어내지 않습니다
#    "프로필에 없는 경력·수치·자격증을 만들어내지 말 것"을 프롬프트에 명시하고
#    테스트로도 검증합니다. 재료가 부족하면 지어내는 대신 무엇이 부족한지
#    알려줍니다. 나오는 것은 초안이니 반드시 본인 표현으로 다듬어 쓰세요.
#
#  비용
#    쓴 만큼만 과금됩니다. 자소서 초안 1건에 대략 70원, 적합도 분석은 그보다
#    저렴합니다. 구직 활동 규모에서는 부담되는 수준이 아닙니다.
#
#  발급 방법
#    https://console.anthropic.com → API Keys → Create Key
#    (결제 수단 등록이 필요합니다)
#
ANTHROPIC_API_KEY=


# ============================================================================
#  7. 마감 임박 알림 — 텔레그램 (권장) 또는 이메일                     [무료]
# ============================================================================
#
#  무엇을 하나요
#    보관함에 담아둔 공고 중 마감이 3일 이내인 것을 알려줍니다.
#    앱을 열지 않아도 되도록 따로 실행할 수 있습니다:
#
#      python notify.py --dry-run    보내지 않고 내용만 확인
#      python notify.py              실제 발송 (마감 3일 이내)
#      python notify.py --days 5     5일 이내로 넓히기
#
#    윈도우 작업 스케줄러에 등록하면 매일 자동 실행됩니다.
#      프로그램: python   /   인수: notify.py   /   시작 위치: 이 폴더 경로
#    같은 공고를 하루에 두 번 보내지 않도록 발송 기록이 남습니다.
#
#  --- 텔레그램 (설정이 더 간단합니다) ---
#    1) 텔레그램에서 @BotFather 검색 → /newbot → 봇 이름 지정 → 토큰 받기
#    2) 만든 봇과 대화창을 열고 아무 메시지나 보내기 (이걸 해야 chat id가 잡힙니다)
#    3) 브라우저에서 https://api.telegram.org/bot<토큰>/getUpdates 접속
#    4) 응답에서 "chat":{"id":123456789 부분의 숫자를 복사
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

#  --- 이메일 (SMTP) ---
#    Gmail은 계정 비밀번호가 아니라 '앱 비밀번호'가 필요합니다.
#      1) Google 계정에서 2단계 인증을 켭니다
#      2) https://myaccount.google.com/apppasswords 에서 앱 비밀번호 생성
#      3) 생성된 16자리를 SMTP_PASSWORD에 넣습니다 (공백은 빼도 됩니다)
#    ALERT_EMAIL_TO를 비우면 SMTP_USER 주소로 보냅니다.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=


# ============================================================================
#  8. 그 밖의 설정 (거의 건드릴 일 없음)
# ============================================================================
#
#  JOB_HELPER_DB
#    SQLite 파일 경로를 바꿉니다. DATABASE_URL이 설정되어 있으면 무시됩니다.
#    기본값은 프로젝트 폴더의 jobs.db 입니다.
#
# JOB_HELPER_DB=
