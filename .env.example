# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git에 올라가지 않습니다.

# --- 보관함 영구 저장 (Streamlit Cloud에 배포할 때 필수) --------------------
# 설정하지 않으면 로컬 SQLite(jobs.db)를 씁니다. 로컬 실행만 한다면 비워두세요.
# Streamlit Cloud는 파일시스템이 휘발성이라, 이 값이 없으면 재시작 때마다
# 보관함이 초기화됩니다.
#
# Supabase 무료 플랜 기준:
#   1. https://supabase.com/dashboard 에서 프로젝트 생성
#   2. 상단 초록색 [Connect] -> Direct Connection string 탭
#   3. Connection Method: 반드시 "Session pooler" 선택
#      (Direct connection은 IPv6 전용이라 Streamlit Cloud에서 연결 안 됨)
#   4. Type: URI 로 두고 문자열 복사
#   5. [YOUR-PASSWORD] 자리를 Database Password로 교체
#   6. 설정 실행: python setup_cloud.py
DATABASE_URL=

# --- 기업 규모·보수 정보 (공공데이터포털) ---------------------------------
# https://www.data.go.kr → "국민연금공단_국민연금 가입 사업장 내역" 활용신청
# 발급 후 "일반 인증키(Decoding)" 값을 넣으세요.
NPS_SERVICE_KEY=

# --- 워크넷 채용공고 (고용24 오픈API) --------------------------------------
# https://openapi.work.go.kr → 오픈API 신청 → 채용정보
WORKNET_AUTH_KEY=

# --- 마감 알림: 텔레그램 ----------------------------------------------------
# @BotFather 에게 /newbot 으로 봇을 만들고 받은 토큰,
# 봇에게 아무 메시지나 보낸 뒤 https://api.telegram.org/bot<토큰>/getUpdates 에서 chat id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 마감 알림: 이메일 ------------------------------------------------------
# Gmail은 2단계 인증 후 "앱 비밀번호"를 발급받아 SMTP_PASSWORD에 넣으세요.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
